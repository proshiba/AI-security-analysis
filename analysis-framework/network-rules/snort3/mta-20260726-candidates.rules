# Malware-Traffic-Analysis.net PCAP 50件を人手レビューして残したSnort 3候補
# source IOCの機械変換ではなく、PCAPで直接確認した通信構造から作成した。
# Snort 3 engineと独立した無害PCAP corpusで検証するまではcandidate扱いとする。

alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"POLICY NetSupport Manager POST fakeurl observed in malware campaign"; flow:to_server,established; service:http; http_method; content:"POST"; http_uri:path; content:"/fakeurl.htm",fast_pattern,nocase; http_header:field user-agent; content:"NetSupport Manager/1.3",nocase; classtype:policy-violation; sid:9100000; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE XLoader Formbook K013 spoofed UA and short POST path"; flow:to_server,established; service:http; http_method; content:"POST"; http_uri:path; pcre:"/^\/[a-z0-9]{4}\/$/i"; http_header:field user-agent; content:"K013 Build/LRX21V",fast_pattern,nocase; classtype:trojan-activity; sid:9100001; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE XLoader Formbook Windows Phone spoofed UA and short POST path"; flow:to_server,established; service:http; http_method; content:"POST"; http_uri:path; pcre:"/^\/[a-z0-9]{4}\/$/i"; http_header:field user-agent; content:"IEMobile/11.0; NOKIA; Lumia 929",fast_pattern,nocase; classtype:trojan-activity; sid:9100002; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE XLoader Formbook Lenovo Pinterest spoofed UA and short GET path"; flow:to_server,established; service:http; http_method; content:"GET"; http_uri:path; pcre:"/^\/[a-z0-9]{4}\/$/i"; http_header:field user-agent; content:"Lenovo A5000",fast_pattern,nocase; content:"Pinterest/Android",nocase; classtype:trojan-activity; sid:9100003; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE StealC v2 hexadecimal PHP POST path"; flow:to_server,established; service:http; http_method; content:"POST"; http_uri:path; content:".php",fast_pattern,nocase; pcre:"/^\/[0-9a-f]{16}\.php$/i"; classtype:trojan-activity; sid:9100004; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE SmartApeSG Lumma stage wbinjget"; flow:to_server,established; service:http; http_method; content:"GET"; http_uri:path; content:"/wbinjget",fast_pattern,nocase; classtype:trojan-activity; sid:9100005; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE SmartApeSG Lumma stage wmglb"; flow:to_server,established; service:http; http_method; content:"GET"; http_uri:path; content:"/wmglb",fast_pattern,nocase; classtype:trojan-activity; sid:9100006; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE Lumma follow-up soks executable download"; flow:to_server,established; service:http; http_method; content:"GET"; http_uri:path; content:"/soks.exe",fast_pattern,nocase; classtype:trojan-activity; sid:9100007; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 21 (msg:"MALWARE AgentTesla style FTP exfil password artifact"; flow:to_server,established; service:ftp; content:"STOR PW_",fast_pattern,nocase; classtype:trojan-activity; sid:9100008; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 21 (msg:"MALWARE AgentTesla style FTP exfil Thunderbird contacts artifact"; flow:to_server,established; service:ftp; content:"STOR Contacts_Thunderbird",fast_pattern,nocase; classtype:trojan-activity; sid:9100009; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE Remcos legacy cleartext protocol header and delimiter"; flow:to_server,established; content:"|24 04 ff 00|",depth 4,fast_pattern; content:"|7c 1e 1e 1f 7c|",distance 4,within 64; classtype:trojan-activity; sid:9100010; rev:1;)
